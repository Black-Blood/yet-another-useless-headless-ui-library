{
  "tasks": {
    "start": "deno run --allow-env=GITHUB_TOKEN,PROJECT_TOKEN,GITHUB_REPOSITORY,DRY_RUN,FORCE --allow-net=api.github.com --allow-read=./config.yml src/main.ts",
    "test": "deno test --allow-read=.",
    "check": "deno check src test"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/yaml": "jsr:@std/yaml@^1.3.0"
  }
}
